@model IEnumerable<JoinIt.Models.Amizade>

@{
    ViewData["Title"] = "Amigos";

    var userId = ViewBag.UserId as string;

    var amigos = Model
        .Where(a => a.Estado == JoinIt.Enums.EstadoAmizade.Aceite)
        .ToList();

    var pedidosRecebidos = Model
        .Where(a =>
            a.PedidoAId == userId &&
            a.Estado == JoinIt.Enums.EstadoAmizade.Pendente)
        .ToList();

    var pedidosEnviados = Model
        .Where(a =>
            a.PedidoPorId == userId &&
            a.Estado == JoinIt.Enums.EstadoAmizade.Pendente)
        .ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Amigos</h1>

        <p class="text-muted mb-0">
            Gere os teus amigos e pedidos de amizade.
        </p>
    </div>

    <a asp-controller="Perfis"
       asp-action="Index"
       class="btn btn-primary">
        Encontrar utilizadores
    </a>
</div>

<section class="mb-5">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Pedidos recebidos</h2>

        <span class="badge bg-warning text-dark">
            @pedidosRecebidos.Count
        </span>
    </div>

    @if (!pedidosRecebidos.Any())
    {
        <div class="alert alert-light border">
            Não tens pedidos de amizade pendentes.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var amizade in pedidosRecebidos)
            {
                var utilizador = amizade.PedidoPor;

                <div class="col-12 col-md-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">

                            <h3 class="h5 mb-1">
                                @utilizador.Nome
                            </h3>

                            <p class="text-muted">
                                @utilizador.UserName
                            </p>

                            <div class="d-flex gap-2 flex-wrap">

                                <a asp-controller="Perfis"
                                   asp-action="Details"
                                   asp-route-id="@utilizador.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    Ver perfil
                                </a>

                                <form asp-action="Aceitar"
                                      asp-route-id="@amizade.Id"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-success btn-sm">
                                        Aceitar
                                    </button>
                                </form>

                                <form asp-action="Rejeitar"
                                      asp-route-id="@amizade.Id"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        Rejeitar
                                    </button>
                                </form>

                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }

</section>

<section class="mb-5">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Os meus amigos</h2>

        <span class="badge bg-success">
            @amigos.Count
        </span>
    </div>

    @if (!amigos.Any())
    {
        <div class="alert alert-light border">
            Ainda não tens amigos adicionados.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var amizade in amigos)
            {
                var utilizador = amizade.PedidoPorId == userId
                ? amizade.PedidoA
                : amizade.PedidoPor;

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">

                            <div class="d-flex gap-3 align-items-center">

                                <div class="flex-shrink-0">

                                    @if (!string.IsNullOrWhiteSpace(utilizador.FotoPerfil))
                                    {
                                        <img src="@utilizador.FotoPerfil"
                                             alt="Fotografia de @utilizador.Nome"
                                             class="rounded-circle border"
                                             style="width: 90px;
                                                height: 90px;
                                                object-fit: cover;" />
                                    }
                                    else
                                    {
                                        var inicial = !string.IsNullOrWhiteSpace(utilizador.Nome)
                                        ? utilizador.Nome.Substring(0, 1).ToUpper()
                                        : "?";

                                        <div class="rounded-circle bg-dark text-warning
                                                d-flex justify-content-center
                                                align-items-center"
                                             style="width: 90px;
                                                height: 90px;
                                                font-size: 2rem;
                                                font-weight: 600;">
                                            @inicial
                                        </div>
                                    }

                                </div>

                                <div class="flex-grow-1">

                                    <h3 class="h5 mb-1">
                                        @utilizador.Nome
                                    </h3>

                                    <p class="text-muted mb-3">
                                        @utilizador.UserName
                                    </p>

                                    <div class="d-flex gap-2 flex-wrap">

                                        <a asp-controller="Perfis"
                                           asp-action="Details"
                                           asp-route-id="@utilizador.Id"
                                           class="btn btn-primary btn-sm">
                                            Ver perfil
                                        </a>

                                        <form asp-action="RemoverAmigo"
                                              asp-route-id="@amizade.Id"
                                              method="post"
                                              onsubmit="return confirm('Tens a certeza de que queres remover este amigo?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm">
                                                Remover amigo
                                            </button>

                                        </form>

                                    </div>

                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }

</section>

<section>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Pedidos enviados</h2>

        <span class="badge bg-secondary">
            @pedidosEnviados.Count
        </span>
    </div>

    @if (!pedidosEnviados.Any())
    {
        <div class="alert alert-light border">
            Não tens pedidos enviados pendentes.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var amizade in pedidosEnviados)
            {
                var utilizador = amizade.PedidoA;

                <div class="col-12 col-md-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">

                            <h3 class="h5 mb-1">
                                @utilizador.Nome
                            </h3>

                            <p class="text-muted mb-2">
                                @utilizador.UserName
                            </p>

                            <span class="badge bg-warning text-dark me-2">
                                Pendente
                            </span>

                            <a asp-controller="Perfis"
                               asp-action="Details"
                               asp-route-id="@utilizador.Id"
                               class="btn btn-outline-primary btn-sm">
                                Ver perfil
                            </a>

                            <form asp-action="CancelarPedido"
                                  asp-route-id="@amizade.Id"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-outline-danger btn-sm">
                                    Cancelar pedido
                                </button>

                            </form>

                        </div>
                    </div>
                </div>
            }
        </div>
    }

</section>