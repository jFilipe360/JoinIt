@model IEnumerable<JoinIt.Models.Notificacao>

@{
    ViewData["Title"] = "Notificações";
    var existemNaoLidas = Model.Any(n => !n.Lida);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Notificações</h1>

        <p class="text-muted mb-0">
            Consulta as novidades da tua conta.
        </p>
    </div>

    @if (existemNaoLidas)
    {
        <form asp-action="MarcarTodasComoLidas"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-outline-primary">
                Marcar todas como lidas
            </button>
        </form>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Ainda não tens notificações.
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">

        @foreach (var notificacao in Model)
        {
            <div class="card shadow-sm
                                @(!notificacao.Lida ? "border-warning" : "")">

                <div class="card-body">

                    <div class="d-flex justify-content-between gap-3">

                        <div>
                            <p class="mb-2">
                                @notificacao.Mensagem
                            </p>

                            <small class="text-muted">
                                @notificacao.CriadaEm.ToString("dd/MM/yyyy HH:mm")
                            </small>
                        </div>

                        @if (!notificacao.Lida)
                        {
                            <span class="badge bg-warning text-dark align-self-start">
                                Nova
                            </span>
                        }

                    </div>

                    @if (!notificacao.Lida ||
                                !string.IsNullOrWhiteSpace(notificacao.Link))
                    {
                        <form asp-action="MarcarComoLida"
                              asp-route-id="@notificacao.Id"
                              method="post"
                              class="mt-3">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-sm btn-primary">

                                @if (!string.IsNullOrWhiteSpace(notificacao.Link))
                                {
                                    <span>Abrir</span>
                                }
                                else
                                {
                                    <span>Marcar como lida</span>
                                }

                            </button>
                        </form>
                    }

                </div>
            </div>
        }

    </div>
}