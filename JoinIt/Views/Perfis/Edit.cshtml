@model JoinIt.Models.ApplicationUser

@{
    ViewData["Title"] = "Editar Perfil";

    var inicial = !string.IsNullOrWhiteSpace(Model.Nome)
        ? Model.Nome.Substring(0, 1).ToUpper()
        : "?";

    var fotoUrlAtual = "";

    if (!string.IsNullOrWhiteSpace(Model.FotoPerfil) &&
        Uri.TryCreate(
            Model.FotoPerfil,
            UriKind.Absolute,
            out var uriFoto) &&
        (uriFoto.Scheme == Uri.UriSchemeHttp ||
         uriFoto.Scheme == Uri.UriSchemeHttps))
    {
        fotoUrlAtual = Model.FotoPerfil;
    }
}

<div class="mb-4">
    <h1 class="mb-1">Editar Perfil</h1>

    <p class="text-muted mb-0">
        Atualiza os teus dados pessoais.
    </p>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <div class="row g-4">

            <div class="col-12 col-md-4 text-center">

                @if (!string.IsNullOrWhiteSpace(Model.FotoPerfil))
                {
                    <img id="foto-preview"
                         src="@Model.FotoPerfil"
                         alt="Fotografia de perfil"
                         class="rounded-circle border"
                         style="width: 160px;
                                    height: 160px;
                                    object-fit: cover;" />

                    <div id="foto-inicial"
                         class="rounded-circle bg-dark text-warning
                                    justify-content-center align-items-center mx-auto"
                         style="width: 160px;
                                    height: 160px;
                                    font-size: 3.5rem;
                                    font-weight: 600;
                                    display: none;">
                        @inicial
                    </div>
                }
                else
                {
                    <img id="foto-preview"
                         src=""
                         alt="Fotografia de perfil"
                         class="rounded-circle border"
                         style="width: 160px;
                                    height: 160px;
                                    object-fit: cover;
                                    display: none;" />

                    <div id="foto-inicial"
                         class="rounded-circle bg-dark text-warning
                                    d-flex justify-content-center
                                    align-items-center mx-auto"
                         style="width: 160px;
                                    height: 160px;
                                    font-size: 3.5rem;
                                    font-weight: 600;">
                        @inicial
                    </div>
                }

            </div>

            <div class="col-12 col-md-8">

                <form asp-action="Edit"
                      method="post"
                      enctype="multipart/form-data">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="Nome"
                               class="form-label">
                            Nome
                        </label>

                        <input asp-for="Nome"
                               class="form-control"
                               maxlength="100"
                               placeholder="O teu nome" />

                        <span asp-validation-for="Nome"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Nome de utilizador
                        </label>

                        <input value="@Model.UserName"
                               class="form-control"
                               disabled />

                        <div class="form-text">
                            O nome de utilizador não pode ser alterado aqui.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Email
                        </label>

                        <input value="@Model.Email"
                               class="form-control"
                               disabled />
                    </div>

                    <div class="mb-3">
                        <label for="fotografia"
                               class="form-label">
                            Carregar fotografia
                        </label>

                        <input id="fotografia"
                               name="fotografia"
                               type="file"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                        @Html.ValidationMessage(
                        "fotografia",
                                                null,
                                                new { @class = "text-danger" }
                                                )

                        <div class="form-text">
                            Formatos permitidos: JPG, PNG e WebP.
                            Tamanho máximo: 2 MB.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="FotoPerfil"
                               class="form-label">
                            URL da fotografia
                        </label>

                        <input id="FotoPerfil"
                               name="fotoPerfil"
                               type="url"
                               value="@fotoUrlAtual"
                               class="form-control"
                               placeholder="https://exemplo.com/foto.jpg" />

                        <span asp-validation-for="FotoPerfil"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            Podes carregar um ficheiro ou indicar um URL.
                            O ficheiro tem prioridade.
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.FotoPerfil))
                    {
                        <div class="form-check mb-4">
                            <input id="removerFoto"
                                   name="removerFoto"
                                   value="true"
                                   type="checkbox"
                                   class="form-check-input" />

                            <label for="removerFoto"
                                   class="form-check-label">
                                Remover fotografia atual
                            </label>
                        </div>
                    }

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Guardar alterações
                        </button>

                        <a asp-action="MeuPerfil"
                           class="btn btn-secondary">
                            Cancelar
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const fotoUrlInput =
                document.getElementById("FotoPerfil");

            const fotografiaInput =
                document.getElementById("fotografia");

            const removerFotoInput =
                document.getElementById("removerFoto");

            const fotoPreview =
                document.getElementById("foto-preview");

            const fotoInicial =
                document.getElementById("foto-inicial");

            let ficheiroPreviewUrl = null;

            // Apresenta uma imagem na área de pré-visualização
            function mostrarImagem(url) {
                fotoPreview.src = url;
                fotoPreview.style.display = "block";
                fotoInicial.style.display = "none";
            }

            // Apresenta a imagem inicial quando não existe fotografia válida
            function mostrarInicial() {
                fotoPreview.style.display = "none";
                fotoInicial.style.display = "flex";
            }

            // Cria uma pré-visualização do ficheiro escolhido
            fotografiaInput.addEventListener("change", function () {

                const ficheiro = fotografiaInput.files[0];

                if (!ficheiro) {
                    const url = fotoUrlInput.value.trim();

                    if (url !== "") {
                        mostrarImagem(url);
                    }

                    return;
                }

                if (ficheiroPreviewUrl !== null) {
                    URL.revokeObjectURL(ficheiroPreviewUrl);
                }

                ficheiroPreviewUrl =
                    URL.createObjectURL(ficheiro);

                mostrarImagem(ficheiroPreviewUrl);

                if (removerFotoInput) {
                    removerFotoInput.checked = false;
                }
            });

            // Atualiza a pré-visualização enquanto o URL é alterado
            fotoUrlInput.addEventListener("input", function () {

                if (fotografiaInput.files.length > 0) {
                    return;
                }

                const url = fotoUrlInput.value.trim();

                if (url === "") {
                    mostrarInicial();
                }
                else {
                    mostrarImagem(url);
                }

                if (removerFotoInput) {
                    removerFotoInput.checked = false;
                }
            });

            // Limpa as opções de fotografia quando é pedida a sua remoção
            if (removerFotoInput) {
                removerFotoInput.addEventListener("change", function () {

                    if (removerFotoInput.checked) {
                        fotografiaInput.value = "";
                        fotoUrlInput.value = "";
                        mostrarInicial();
                    }
                });
            }

            fotoPreview.addEventListener("error", function () {
                mostrarInicial();
            });

            fotoPreview.addEventListener("load", function () {
                fotoPreview.style.display = "block";
                fotoInicial.style.display = "none";
            });

        });
    </script>
}