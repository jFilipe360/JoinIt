@model JoinIt.Models.ApplicationUser

@{
    ViewData["Title"] = "Perfil";

    var eventosCriados =
        ViewBag.EventosCriados as List<JoinIt.Models.Evento>
        ?? new List<JoinIt.Models.Evento>();

    var eventosParticipa =
        ViewBag.EventosParticipa as List<JoinIt.Models.Evento>
        ?? new List<JoinIt.Models.Evento>();

    bool souDono = ViewBag.SouDono == true;

    var amizade = ViewBag.Amizade as JoinIt.Models.Amizade;

    var utilizadorAtualId = User.FindFirst(
        System.Security.Claims.ClaimTypes.NameIdentifier
    )?.Value;

    var inicial = !string.IsNullOrWhiteSpace(Model.Nome)
        ? Model.Nome.Substring(0, 1).ToUpper()
        : "?";
}

<div class="card shadow-sm mb-4">
    <div class="card-body">

        <div class="d-flex flex-column flex-md-row align-items-center gap-4">

            @if (!string.IsNullOrWhiteSpace(Model.FotoPerfil))
            {
                <img src="@Model.FotoPerfil"
                     alt="Fotografia de @Model.Nome"
                     class="rounded-circle border"
                     style="width: 130px;
                                height: 130px;
                                object-fit: cover;" />
            }
            else
            {
                <div class="rounded-circle bg-dark text-warning
                                d-flex justify-content-center align-items-center"
                     style="width: 130px;
                                height: 130px;
                                font-size: 3rem;
                                font-weight: 600;">
                    @inicial
                </div>
            }

            <div class="flex-grow-1 text-center text-md-start">

                <h1 class="mb-1">
                    @Model.Nome
                </h1>

                <p class="text-muted mb-2">
                    @Model.UserName
                </p>

                <p class="mb-3">
                    Membro desde
                    @Model.CriadoEm.ToString("dd/MM/yyyy")
                </p>

                @if (souDono)
                {
                    <a asp-action="Edit"
                       class="btn btn-warning">
                        Editar perfil
                    </a>
                }
                else if (amizade == null ||
                amizade.Estado == JoinIt.Enums.EstadoPedido.Rejeitado)
                {
                    <form asp-controller="Amizades"
                          asp-action="Enviar"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-primary">
                            Enviar pedido de amizade
                        </button>
                    </form>
                }
                else if (amizade.Estado == JoinIt.Enums.EstadoPedido.Pendente)
                {
                    if (amizade.PedidoPorId == utilizadorAtualId)
                    {
                        <button class="btn btn-secondary" disabled>
                            Pedido enviado
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-warning" disabled>
                            Pedido recebido
                        </button>
                    }
                }
                else if (amizade.Estado == JoinIt.Enums.EstadoPedido.Aceite)
                {
                    <span class="badge bg-success p-2">
                        Amigos
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary p-2">
                        Pedido rejeitado
                    </span>
                }

            </div>

        </div>

    </div>
</div>

<section class="mb-5">

    <div class="d-flex justify-content-between
                align-items-center mb-3">

        <h2 class="h4 mb-0">
            Eventos criados
        </h2>

        <span class="badge bg-secondary">
            @eventosCriados.Count
        </span>

    </div>

    @if (!eventosCriados.Any())
    {
        <div class="alert alert-light border">
            Este utilizador ainda não criou eventos visíveis.
        </div>
    }
    else
    {
        <div class="row g-3">

            @foreach (var evento in eventosCriados)
            {
                <div class="col-12 col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">

                            <div class="d-flex justify-content-between
                                                align-items-start mb-2">

                                <span class="badge bg-warning text-dark">
                                    @(evento.Categoria?.Nome
                                                                ?? "Sem categoria")
                        </span>

                        @if (evento.IsPrivado)
                                {
                                    <span class="badge bg-danger">
                                        Privado
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        Público
                                    </span>
                                }

                            </div>

                            <h3 class="h5">
                                @evento.Titulo
                            </h3>

                            <p class="text-muted">
                                @evento.DataHora.ToString(
                                "dd/MM/yyyy HH:mm"
                                                )
                    </p>

                    <p>
                        @evento.Participantes.Count /
                        @evento.NumMaxParticipantes
                        participantes
                    </p>

                    <a asp-controller="Eventos"
                       asp-action="Details"
                       asp-route-id="@evento.Id"
                       class="btn btn-primary btn-sm mt-auto">
                        Ver evento
                    </a>

                </div>
            </div>

        </div>
                }

        </div>
    }

</section>

<section>

    <div class="d-flex justify-content-between
                align-items-center mb-3">

        <h2 class="h4 mb-0">
            Eventos em que participa
        </h2>

        <span class="badge bg-secondary">
            @eventosParticipa.Count
        </span>

    </div>

    @if (!eventosParticipa.Any())
    {
        <div class="alert alert-light border">
            Este utilizador ainda não participa noutros eventos visíveis.
        </div>
    }
    else
    {
        <div class="row g-3">

            @foreach (var evento in eventosParticipa)
            {
                <div class="col-12 col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">

                            <div class="d-flex justify-content-between
                                                align-items-start mb-2">

                                <span class="badge bg-warning text-dark">
                                    @(evento.Categoria?.Nome
                                                                ?? "Sem categoria")
                        </span>

                        @if (evento.IsPrivado)
                                {
                                    <span class="badge bg-danger">
                                        Privado
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        Público
                                    </span>
                                }

                            </div>

                            <h3 class="h5">
                                @evento.Titulo
                            </h3>

                            <p class="text-muted">
                                @evento.DataHora.ToString(
                                "dd/MM/yyyy HH:mm"
                                                )
                    </p>

                    <p>
                        @evento.Participantes.Count /
                        @evento.NumMaxParticipantes
                        participantes
                    </p>

                    <a asp-controller="Eventos"
                       asp-action="Details"
                       asp-route-id="@evento.Id"
                       class="btn btn-primary btn-sm mt-auto">
                        Ver evento
                    </a>

                </div>
            </div>

        </div>
                }

        </div>
    }

</section>