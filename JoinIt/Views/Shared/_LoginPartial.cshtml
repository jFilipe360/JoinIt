@using JoinIt.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext

@{
    var numeroNotificacoes = 0;

    if (User.Identity?.IsAuthenticated == true)
    {
        var utilizadorId = UserManager.GetUserId(User);

        if (!string.IsNullOrEmpty(utilizadorId))
        {
            numeroNotificacoes = await DbContext.Notificacoes
                .AsNoTracking()
                .CountAsync(n =>
                    n.UtilizadorId == utilizadorId &&
                    !n.Lida);
        }
    }
}

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link" asp-controller="Notificacoes" asp-action="Index">
            <i class="bi bi-bell-fill"></i>
            @if (numeroNotificacoes > 0)
            {
                <span class="badge bg-danger ms-1">@numeroNotificacoes</span>
            }
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link" asp-controller="Perfis" asp-action="MeuPerfil">O Meu Perfil</a>
    </li>

    <li class="nav-item">
        <form  class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button  type="submit" class="nav-link btn btn-link text-dark">Terminar Sessão</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Criar Conta</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Iniciar Sessão</a>
    </li>
}
</ul>
