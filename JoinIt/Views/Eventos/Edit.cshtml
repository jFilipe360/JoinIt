@model JoinIt.Models.Evento

@{
    ViewData["Title"] = "Editar Evento";
}

<div class="mb-4">
    <h1 class="mb-1">Editar Evento</h1>

    <p class="text-muted mb-0">
        Altera os dados ou a localização do evento.
    </p>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label asp-for="Titulo" class="form-label">
                    Título
                </label>

                <input asp-for="Titulo"
                       class="form-control" />

                <span asp-validation-for="Titulo"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Descricao" class="form-label">
                    Descrição
                </label>

                <textarea asp-for="Descricao"
                          class="form-control"
                          rows="5"></textarea>

                <span asp-validation-for="Descricao"
                      class="text-danger">
                </span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">

                    <label asp-for="DataHora" class="form-label">
                        Data e hora
                    </label>

                    <input asp-for="DataHora"
                           asp-format="{0:yyyy-MM-ddTHH:mm}"
                           type="datetime-local"
                           class="form-control" />

                    <span asp-validation-for="DataHora"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="CategoriaId" class="form-label">
                        Categoria
                    </label>

                    <select asp-for="CategoriaId"
                            asp-items="ViewBag.CategoriaId"
                            class="form-select">

                        <option value="">
                            Escolhe uma categoria
                        </option>

                    </select>

                    <span asp-validation-for="CategoriaId"
                          class="text-danger">
                    </span>

                </div>
            </div>

            <div class="mb-3">

                <label asp-for="NumMaxParticipantes"
                       class="form-label">
                    Número máximo de participantes
                </label>

                <input asp-for="NumMaxParticipantes"
                       type="number"
                       min="1"
                       class="form-control" />

                <span asp-validation-for="NumMaxParticipantes"
                      class="text-danger">
                </span>

            </div>

            <div class="form-check mb-4">

                <input asp-for="IsPrivado"
                       class="form-check-input" />

                <label asp-for="IsPrivado"
                       class="form-check-label">
                    Evento privado
                </label>

            </div>

            <div class="mb-4">

                <label class="form-label">
                    Localização
                </label>

                <p class="text-muted small">
                    Clica no mapa ou arrasta o marcador para alterar a localização.
                </p>

                <div id="map" class="event-map"></div>

                <input asp-for="Latitude" type="hidden" />
                <input asp-for="Longitude" type="hidden" />

                <div class="mt-2">
                    <small id="coordenadas" class="text-muted"></small>
                </div>

                <span asp-validation-for="Latitude"
                      class="text-danger d-block">
                </span>

                <span asp-validation-for="Longitude"
                      class="text-danger d-block">
                </span>

            </div>

            <div class="d-flex gap-2">

                <button type="submit" class="btn btn-primary">
                    Guardar Alterações
                </button>

                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-secondary">
                    Cancelar
                </a>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const latitudeInput =
                document.getElementById("Latitude");

            const longitudeInput =
                document.getElementById("Longitude");

            const coordenadasTexto =
                document.getElementById("coordenadas");

            const latitudeInicial = Number.parseFloat(
                latitudeInput.value.replace(",", ".")
            );

            const longitudeInicial = Number.parseFloat(
                longitudeInput.value.replace(",", ".")
            );

            // Verifica se o evento já possui uma localização válida
            const temLocalizacaoInicial =
                Number.isFinite(latitudeInicial) &&
                Number.isFinite(longitudeInicial) &&
                !(latitudeInicial === 0 && longitudeInicial === 0);

            const latitudePadrao = 39.5;
            const longitudePadrao = -8.0;

            // Inicializa o mapa na localização do evento ou no centro de Portugal
            const map = L.map("map").setView(
                temLocalizacaoInicial
                    ? [latitudeInicial, longitudeInicial]
                    : [latitudePadrao, longitudePadrao],
                temLocalizacaoInicial ? 15 : 7
            );

            L.tileLayer(
                "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
                {
                    maxZoom: 19,
                    attribution:
                        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
                }
            ).addTo(map);

            let marker = null;

            // Atualiza os campos escondidos usados pelo formulário
            function atualizarCoordenadas(latitude, longitude) {

                const latitudeFormatada =
                    latitude.toFixed(6).replace(".", ",");

                const longitudeFormatada =
                    longitude.toFixed(6).replace(".", ",");

                latitudeInput.value = latitudeFormatada;
                longitudeInput.value = longitudeFormatada;

                coordenadasTexto.textContent =
                    "Latitude: " +
                    latitude.toFixed(6) +
                    " | Longitude: " +
                    longitude.toFixed(6);
            }

            // Cria o marcador ou altera a sua posição
            function colocarMarcador(latitude, longitude) {

                if (marker === null) {

                    marker = L.marker(
                        [latitude, longitude],
                        {
                            draggable: true
                        }
                    ).addTo(map);

                    marker.on("dragend", function () {

                        const posicao = marker.getLatLng();

                        atualizarCoordenadas(
                            posicao.lat,
                            posicao.lng
                        );
                    });
                }
                else {
                    marker.setLatLng([
                        latitude,
                        longitude
                    ]);
                }

                atualizarCoordenadas(latitude, longitude);
            }

            if (temLocalizacaoInicial) {
                colocarMarcador(
                    latitudeInicial,
                    longitudeInicial
                );
            }

            // Permite escolher uma nova localização ao clicar no mapa
            map.on("click", function (evento) {

                colocarMarcador(
                    evento.latlng.lat,
                    evento.latlng.lng
                );
            });
        });
    </script>
}