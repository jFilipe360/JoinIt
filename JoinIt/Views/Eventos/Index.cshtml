@model IEnumerable<JoinIt.Models.Evento>

@{
    ViewData["Title"] = "Eventos";

    var userId = User.FindFirst(
        System.Security.Claims.ClaimTypes.NameIdentifier
    )?.Value;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Eventos</h1>
        <p class="text-muted mb-0">
            Descobre atividades e junta-te à comunidade.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Criar Evento
    </a>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <h4>Ainda não existem eventos</h4>

            <p class="text-muted">
                Cria o primeiro evento e convida outras pessoas a participar.
            </p>

            <a asp-action="Create" class="btn btn-primary">
                Criar Evento
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">

                    <div class="card-body d-flex flex-column">

                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge bg-warning text-dark">
                                @(item.Categoria?.Nome ?? "Sem categoria")
                            </span>

                            @if (item.IsPrivado)
                            {
                                <span class="badge bg-danger">
                                    Privado
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    Público
                                </span>
                            }
                        </div>

                        <h4 class="card-title">
                            @item.Titulo
                        </h4>

                        <p class="text-muted mb-2">
                            @item.DataHora.ToString("dd/MM/yyyy HH:mm")
                        </p>

                        <p class="card-text flex-grow-1">
                            @item.Descricao
                        </p>

                        <hr />

                        <div class="d-flex justify-content-between mb-3">
                            <span>
                                <strong>Participantes:</strong>
                                @item.Participantes.Count /
                                @item.NumMaxParticipantes
                            </span>

                            <span class="text-muted">
                                @item.Estado
                            </span>
                        </div>

                        <div class="d-flex gap-2 flex-wrap">
                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-primary btn-sm">
                                Ver detalhes
                            </a>

                            @if (item.CriadorId == userId)
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">
                                    Editar
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger btn-sm">
                                    Apagar
                                </a>
                            }
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
}