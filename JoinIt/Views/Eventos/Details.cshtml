@using System.Globalization
@model JoinIt.Models.Evento

@{
    ViewData["Title"] = "Detalhes";

    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

    var amigosDisponiveis = ViewBag.AmigosDisponiveis as List<JoinIt.Models.ApplicationUser> ?? new List<JoinIt.Models.ApplicationUser>();

    bool souCriador = Model.CriadorId == userId;

    bool jaParticipo = Model.Participantes.Any(p => p.UserId == userId);

    bool eventoCheio = Model.Participantes.Count >= Model.NumMaxParticipantes;
}

<h1>Detalhes</h1>

<div class="card shadow-sm">

    <div class="card-body">

        <h2>@Model.Titulo</h2>

        <p class="text-muted">
            @Model.DataHora.ToString("dd/MM/yyyy HH:mm")
        </p>

        <span class="badge bg-warning text-dark">
            @Model.Categoria.Nome
        </span>
        <hr />

        <h5>Descrição</h5>
        <p>@Model.Descricao</p>
        <hr />

        <div id="map"
             class="event-map"
             data-latitude="@Model.Latitude.ToString(CultureInfo.InvariantCulture)"
             data-longitude="@Model.Longitude.ToString(CultureInfo.InvariantCulture)"
             data-titulo="@Model.Titulo">
        </div>

        <h5>Participantes</h5>
        <p>
            @Model.Participantes.Count /
            @Model.NumMaxParticipantes
        </p>

        <hr />

        <h4>Participantes</h4>

        @if (Model.Participantes.Any())
        {
            <ul class="list-group">
                @foreach (var participante in Model.Participantes)
                {
                    <li class="list-group-item">
                        @if (participante.IsOrganizador)
                        {
                            <a asp-controller="Perfis" asp-action="Details" asp-route-id="@participante.UserId" class="text-decoration-none">
                                @(participante.User.Nome?? participante.User.UserName)
                            </a>

                            <span class="badge bg-warning text-dark">
                                Organizador
                            </span>
                        }
                        else
                        {
                            <a asp-controller="Perfis" asp-action="Details" asp-route-id="@participante.UserId" class="text-decoration-none">
                                @(participante.User.Nome ?? participante.User.UserName)
                            </a>
                        }
                    </li>
                }
            </ul>
        }
        else
        {
            <p>Ainda não existem participantes.</p>
        }

        @if (souCriador && Model.IsPrivado)
        {
            <hr />

            <h4>Convidar amigos</h4>

            <p class="text-muted">
                Escolhe um amigo para convidar para este evento privado.
            </p>

            @if (amigosDisponiveis.Any())
            {
                <form asp-action="Convidar"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="row g-2 mb-4">

                    @Html.AntiForgeryToken()

                    <div class="col-12 col-md">

                        <select name="utilizadorId"
                                class="form-select"
                                required>

                            <option value="">
                                Escolhe um amigo
                            </option>

                            @foreach (var amigo in amigosDisponiveis)
                            {
                                <option value="@amigo.Id">
                                    @amigo.Nome (@amigo.UserName)
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-12 col-md-auto">

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Enviar convite
                        </button>

                    </div>

                </form>
            }
            else
            {
                <div class="alert alert-light border">
                    Não existem amigos disponíveis para convidar.
                </div>
            }

            <h5>Convites enviados</h5>

            @if (!Model.Convites.Any())
            {
                <p class="text-muted">
                    Ainda não foram enviados convites.
                </p>
            }
            else
            {
                <ul class="list-group">

                    @foreach (var convite in Model.Convites
                                .OrderByDescending(c => c.DataConvite))
                    {
                        <li class="list-group-item
                                       d-flex justify-content-between
                                       align-items-center">

                            <div>
                                <strong>@convite.Utilizador.Nome</strong>

                                <div class="text-muted small">
                                    @convite.Utilizador.UserName
                                </div>
                            </div>

                            @switch (convite.Estado)
                            {
                                case JoinIt.Enums.EstadoConvite.Pendente:
                                    <span class="badge bg-warning text-dark">
                                        Pendente
                                    </span>
                                    break;

                                case JoinIt.Enums.EstadoConvite.Aceite:
                                    <span class="badge bg-success">
                                        Aceite
                                    </span>
                                    break;

                                case JoinIt.Enums.EstadoConvite.Rejeitado:
                                    <span class="badge bg-danger">
                                        Rejeitado
                                    </span>
                                    break;
                            }

                        </li>
                    }

                </ul>
            }
        }

        @if (!souCriador)
        {
            if (jaParticipo)
            {
                <form asp-action="Sair"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-danger">
                        Sair do evento
                    </button>
                </form>
            }
            else if (eventoCheio)
            {
                <button class="btn btn-secondary" disabled>
                    Evento cheio
                </button>
            }
            else
            {
                <form asp-action="Participar"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-primary">
                        Participar
                    </button>
                </form>
            }
        }
    </div>
</div>
<div>
    @if (souCriador)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            Editar
        </a>

        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
            Apagar
        </a>
    }

    <a asp-action="Index" class="btn btn-secondary">
        Voltar
    </a>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const mapElement = document.getElementById("map");

            const latitude = Number.parseFloat(
                mapElement.dataset.latitude
            );

            const longitude = Number.parseFloat(
                mapElement.dataset.longitude
            );

            const titulo = mapElement.dataset.titulo;

            if (!Number.isFinite(latitude) ||
                !Number.isFinite(longitude)) {

                mapElement.innerHTML =
                    '<div class="alert alert-warning">' +
                    'Localização indisponível.' +
                    '</div>';

                return;
            }

            const map = L.map("map", {
                scrollWheelZoom: false
            }).setView(
                [latitude, longitude],
                15
            );

            L.tileLayer(
                "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
                {
                    maxZoom: 19,
                    attribution:
                        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
                }
            ).addTo(map);

            L.marker([latitude, longitude])
                .addTo(map)
                .bindPopup(titulo)
                .openPopup();
        });
    </script>
}